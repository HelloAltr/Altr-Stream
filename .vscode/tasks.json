{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Trigger Windows Build (GitHub Actions)",
      "type": "shell",
      "command": "python3 scripts/trigger_windows_build.py",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": true,
        "clear": false
      }
    },
    {
      "label": "Clean macOS Stray .exe Files",
      "type": "shell",
      "command": "rm -f dist/*.exe packaging/windows/build/*.exe && echo 'Cleaned stray .exe files from macOS workspace.'",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}

