# ==============================================================================
# Altr Stream — Runtime Configuration
# ==============================================================================
# Place this file as .env in your Altr Stream installation directory.

# Port and binding
ALTR_STREAM_PORT=8000
ALTR_STREAM_HOST=0.0.0.0

# SQLite metadata store path inside container
ALTR_STREAM_DATABASE_URL=sqlite+aiosqlite:////app/data/altr_stream.db

# Debug logging (leave false in production)
ALTR_STREAM_DEBUG=false

# Default timeout (seconds) for physical database connections
ALTR_STREAM_DEFAULT_CONNECTION_TIMEOUT_SEC=5.0

# Optional encryption key for stored connection credentials
# ALTR_STREAM_ENCRYPTION_KEY=
