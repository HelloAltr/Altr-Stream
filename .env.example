# Altr Stream — Local Environment Configuration Example
# Copy this file to .env and configure the secrets.
# Do NOT commit .env to source control.

# Altr Feedback Integration (Public Beta works out-of-the-box without an API key)
# ALTR_FEEDBACK_API_KEY is optional and used only for internal/priority deployments.
ALTR_STREAM_FEEDBACK_SERVICE_URL=https://altr-feedback.onrender.com
ALTR_FEEDBACK_API_KEY=
